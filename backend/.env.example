# ── App ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ── Database (AWS RDS PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vfixurpc

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ── AWS ───────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_S3_BUCKET=vfixurpc-uploads

# ── Razorpay ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── MSG91 (SMS/OTP) ───────────────────────────────────────────────
MSG91_AUTH_KEY=XXXXXXXXXXXXXXXXXXXXXX
MSG91_TEMPLATE_ID=XXXXXXXXXXXXXXXXXXXXXX

# ── Firebase (Push notifications) ────────────────────────────────
# Paste entire service-account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
