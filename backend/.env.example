# ── App ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Server-only transactional email. Keep keys out of mobile/admin bundles.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=hriday@vfixurpc.com
EMAIL_FROM_NAME=VfixurPC
# Optional legacy Resend configuration (EMAIL_PROVIDER=resend).
RESEND_API_KEY=
ADMIN_EMAIL_FROM=
ADMIN_NOTIFICATION_EMAILS=hriday@vfixurpc.com,tnagesh1999@gmail.com
ADMIN_PUBLIC_URL=
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ── Database (AWS RDS PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vfixurpc
DB_SSL=true
# Keep true with a publicly trusted database certificate. Only set false for a
# private development database whose certificate chain cannot be validated.
DB_SSL_REJECT_UNAUTHORIZED=true

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=7d

# API documentation is disabled in production unless explicitly enabled.
SWAGGER_ENABLED=false

# Required only when running the one-time seed script. Never reuse this value.
SEED_ADMIN_PASSWORD=

# ── AWS ───────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_S3_BUCKET=vfixurpc-uploads

# ── Razorpay ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Customer registration, sign-in and password-reset OTPs are sent through the
# transactional email provider configured above.
CUSTOMER_LOGIN_OTP_ENABLED=true
# Optional Google Play review account override. Store PLAY_REVIEW_OTP in the
# production secret manager; never commit a real reusable code.
PLAY_REVIEW_USERNAME=
PLAY_REVIEW_OTP=

# ── MSG91 (optional SMS/WhatsApp communications) ─────────────────
MSG91_AUTH_KEY=XXXXXXXXXXXXXXXXXXXXXX
MSG91_TEMPLATE_ID=XXXXXXXXXXXXXXXXXXXXXX
# Optional MSG91 WhatsApp campaign configuration. Marketing templates must be approved first.
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_NAMESPACE=

# ── Firebase (Push notifications) ────────────────────────────────
# Paste entire service-account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Admin browser push (generate once with web-push; keep private key server-side)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:hriday@vfixurpc.com

# Server-only Google Places API (New) key; do not expose in EXPO_PUBLIC variables
GOOGLE_PLACES_API_KEY=
